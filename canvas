// arco
ctx.beginPath();
ctx.lineWidth = 2;
ctx.fillStyle = 'yellow';
ctx.strokeStyle = 'yellow';
ctx.arc(500,100,50,1.5*Math.PI,1.5*Math.PI);
ctx.fill();
ctx.stroke();
ctx.closePath();

